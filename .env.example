# ==============================================================================
# FactIndic Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# Then fill in your respective API keys.
# DO NOT commit your real .env file to git!
# ==============================================================================

# LLM Provider Selection: "gemini" or "groq"
LLM_PROVIDER=gemini

# Model Name:
# For Gemini: "gemini-2.5-flash", "gemini-1.5-flash", etc.
# For Groq:   "llama-3.3-70b-versatile", "llama-3.1-8b-instant", etc.
LLM_MODEL=gemini-2.5-flash

# API Credentials:
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
